# Copy to .env.local and adjust. No secrets belong in this file.
# Local: ws://localhost:3000 with database time-left (npm run stdb:publish:local).
# Maincloud: wss://maincloud.spacetimedb.com with the published database name.
VITE_SPACETIMEDB_HOST=ws://localhost:3000
VITE_SPACETIMEDB_DB_NAME=time-left

# Node scripts (scripts/two-session-check.ts, later the Photon bridge)
SPACETIMEDB_HOST=ws://localhost:3000
SPACETIMEDB_DB_NAME=time-left
