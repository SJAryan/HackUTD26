# Copy to .env (gitignored) and fill in locally. Never commit real values.
PHOTON_API_KEY=
PHOTON_PROJECT_ID=pho_prj_REPLACE_ME
PHOTON_PLATFORM=imessage
# Consenting teammate's iMessage identity, E.164 (+1...) or exact iMessage email
PHOTON_TEST_SENDER=
# Shared line Photon assigned to that sender
PHOTON_AGENT_HANDLE=

# TL-08: the household and incident the enrolled test sender reports for (synthetic seed IDs)
BRIDGE_SENDER_HOUSEHOLD=H17
BRIDGE_INCIDENT_ID=tornado-1
# SpacetimeDB target; same names and defaults as the root .env.example
SPACETIMEDB_HOST=ws://localhost:3000
SPACETIMEDB_DB_NAME=time-left
