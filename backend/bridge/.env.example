# Copy to .env (gitignored) and fill in locally. Never commit real values.
PHOTON_API_KEY=
PHOTON_PROJECT_ID=pho_prj_REPLACE_ME
PHOTON_PLATFORM=imessage
# Consenting teammate's iMessage identity, E.164 (+1...) or exact iMessage email
PHOTON_TEST_SENDER=
# Shared line Photon assigned to that sender
PHOTON_AGENT_HANDLE=
