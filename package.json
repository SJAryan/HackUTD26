{
  "name": "time-left",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "stdb:generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path spacetimedb -y",
    "stdb:publish:local": "spacetime publish --server local --module-path spacetimedb time-left -y",
    "stdb:reset:local": "spacetime publish --server local --module-path spacetimedb time-left --delete-data=always -y",
    "check:tl01": "tsx scripts/two-session-check.ts",
    "check:tl05": "tsx scripts/race-check.ts",
    "check:tl06": "tsx scripts/chat-check.ts",
    "check:tl09": "tsx scripts/consent-check.ts",
    "check:tl11": "tsx scripts/followup-check.ts",
    "check:tl12": "tsx scripts/stale-eta-check.ts",
    "check:tl15": "tsx scripts/confirm-need-check.ts",
    "check:tl20": "tsx scripts/driver-stop-check.ts",
    "check:tl18": "tsx scripts/reset-check.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "demo:invites": "tsx scripts/demo-invites.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "spacetimedb": "2.14.*"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.0.2",
    "tsx": "4.23.15",
    "typescript": "~5.6.2",
    "vite": "^7.1.5"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  }
}
